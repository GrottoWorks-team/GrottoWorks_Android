# ---------------------------------------------------------------------------
# GrottoWorks Mobile (Expo) — mẫu biến môi trường (copy thành `.env` rồi sửa)
#
#   cp .env.example .env
#
# `.env` đã bị gitignore; file này KHÔNG chứa giá trị thật.
# Chỉ biến có tiền tố EXPO_PUBLIC_ mới được nhúng vào bundle phía app.
# Sửa env xong phải restart Metro với `-c` để xoá cache:
#   npx expo start -c
# ---------------------------------------------------------------------------

# Cổng API Gateway (YARP) của môi trường dev.
EXPO_PUBLIC_GATEWAY_PORT=6102

# Base URL đầy đủ của API — bỏ trống để app tự suy ra:
#   web              : http://localhost:6102/api/v1
#   Android emulator : http://10.0.2.2:6102/api/v1
#   máy thật (LAN)   : http://<IP-máy-dev>:6102/api/v1
# EXPO_PUBLIC_API_URL=

# Mật khẩu tài khoản seed dùng cho phần gợi ý ở màn đăng nhập.
# Để trống nếu không muốn hiện khối gợi ý này.
EXPO_PUBLIC_DEMO_PASSWORD=

# Email các tài khoản seed, phân tách bằng dấu phẩy.
EXPO_PUBLIC_DEMO_EMAILS=

# Ảnh nền màn đăng nhập (URL công khai). Bỏ trống dùng ảnh mặc định.
# EXPO_PUBLIC_LOGIN_BG_URL=
